# =============================================================================
# FieldMind AI — local developer environment template
# =============================================================================
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env        (Linux/macOS/Git Bash)
#   copy .env.example .env      (Windows cmd)
#
# `.env` is git-ignored and must NEVER contain real/production secrets —
# the values below are local development defaults only.
#
# Start the infrastructure this file configures with:
#   docker compose up -d
# (see infrastructure/docker/docker-compose.yml — the infra source of truth)
# =============================================================================

# --- Application ---
ENVIRONMENT=local
DEBUG=false

# --- PostgreSQL + PostGIS ---
# Also consumed directly by infrastructure/docker/docker-compose.yml to
# initialize the database container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fieldmind
POSTGRES_USER=fieldmind
POSTGRES_PASSWORD=fieldmind_password
POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Kafka ---
# Host-side (FastAPI running on the developer machine) bootstrap address.
# Containers on fieldmind-network talk to Kafka via kafka:29092 instead —
# see docs/KAFKA.md.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_CLIENT_ID=fieldmind-backend
KAFKA_CONSUMER_GROUP_ID=fieldmind-backend

# --- Authentication (JWT) ---
# Required — the app fails to start without it. Generate a strong random
# value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER commit a real secret here or anywhere else; this is a placeholder.
JWT_SECRET_KEY=changeme-generate-a-long-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Advanced tuning (optional — sane defaults live in backend/app/core/config.py) ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_ECHO=false
# REDIS_MAX_CONNECTIONS=20
# KAFKA_PRODUCER_ACKS=all
